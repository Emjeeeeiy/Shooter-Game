rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pilot profiles: public to read, owners only to write.
    // Photo is a small base64 data URL (client-resized); cap its size so one
    // doc stays well under the 1 MiB limit.
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && (!('photo' in request.resource.data)
          || (request.resource.data.photo is string
            && request.resource.data.photo.size() < 450 * 1024));
    }

    // Global leaderboard: anyone can read, one doc per pilot (doc id = uid).
    // Scores update in place so the board never stacks up — only a better
    // score replaces the stored best.
    match /scores/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == id
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score < 100000000;
      allow delete: if false;
    }

    // Race rooms: any signed-in pilot can create, join and update by code.
    match /rooms/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Presence heartbeats: public to read, owners only to write.
    match /status/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Room invites: recipients read/delete their own, anyone signed in can send.
    match /invites/{uid}/items/{inviteId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Invite replies (accepted / declined): same shape, reverse direction.
    match /inviteReplies/{uid}/items/{replyId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Friend requests: recipients read their own inbox; any pilot can send
    // (sender stamped in fromUid); recipient or sender can delete.
    match /friendRequests/{uid}/items/{requestId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow delete: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == resource.data.fromUid);
    }

    // Friend lists: each side owns its doc; either side can create/remove so
    // accept writes both mirrors and remove cleans both up.
    match /friends/{uid}/list/{fid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == fid);
      allow delete: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == fid);
    }
  }
}
