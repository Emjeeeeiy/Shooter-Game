rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pilot profiles: public to read, owners only to write.
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Global leaderboard: anyone can read, signed-in pilots can post.
    // Score shape is validated so junk can't pollute the board.
    match /scores/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score < 100000000;
      allow update, delete: if false;
    }

    // Race rooms: any signed-in pilot can create, join and update by code.
    match /rooms/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Presence heartbeats: public to read, owners only to write.
    match /status/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Room invites: recipients read/delete their own, anyone signed in can send.
    match /invites/{uid}/items/{inviteId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
