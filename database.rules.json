{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "scores": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["score", "uid"]
    },
    "rooms": {
      "$code": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "status": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null"
      }
    }
  }
}
