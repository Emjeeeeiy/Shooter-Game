{
  "name": "neon-strike",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node --check src/game/engine.js && node --check src/game/renderer.js && node --check src/game/audio.js && echo \"syntax ok\"",
    "format:check": "npx prettier --check src/**/*.{js,vue,css} *.js *.html 2>&1 || true"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
